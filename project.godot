; Geyik 3D - Godot project configuration.
; Edit through the editor where possible; this file is intentionally versioned.

config_version=5

[application]

config/name="Geyik 3D"
config/description="Türkiye ormanlarında geçen sistemik bir birinci şahıs geyik avı oyunu."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/image="res://assets/branding/splash.png"
boot_splash/bg_color=Color(0.027, 0.055, 0.047, 1)
config/icon="res://assets/branding/icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
InputRouter="*res://scripts/autoload/input_router.gd"
SettingsService="*res://scripts/autoload/settings_service.gd"
AudioService="*res://scripts/autoload/audio_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"unicode":119)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"unicode":115)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67,"unicode":99)]
}
fire={
"deadzone": 0.1,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
aim={
"deadzone": 0.1,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82,"unicode":114)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69,"unicode":101)]
}
toggle_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77,"unicode":109)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Animal"
3d_physics/layer_4="Projectile"
3d_physics/layer_5="Interactable"

[physics]

3d/default_gravity=18.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
viewport/hdr_2d=false
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.08, 0.12, 0.1, 1)

[application_boot_splash]

show_image=true
fullsize=true

[audio]

driver/enable_input=false

[network]

limits/debugger/max_queued_messages=2048
